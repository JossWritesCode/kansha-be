{
	"name": "kansha-be",
	"version": "1.0.0",
	"description": "Kansha API: employee recognition platform backend",
	"main": "index.js",
	"engines": {
		"node": ">=20 <25"
	},
	"scripts": {
		"start": "knex migrate:latest && node index.js",
		"test": "cross-env DB_ENV=testing jest --runInBand --detectOpenHandles",
		"server": "nodemon index.js",
		"coverage": "cross-env DB_ENV=testing jest --coverage --detectOpenHandles --forceExit || true",
		"migrate": "knex migrate:latest",
		"seed:badges": "knex seed:run --specific=003-Badges.js",
		"test:watch": "cross-env DB_ENV=testing jest --watch --runInBand --detectOpenHandles",
		"start:no-migrate": "node index.js"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"aws-sdk": "^2.627.0",
		"axios": "^0.19.2",
		"bcryptjs": "^2.4.3",
		"cors": "^2.8.5",
		"csvtojson": "^2.0.10",
		"dotenv": "^8.2.0",
		"express": "^4.17.1",
		"express-jwt": "^5.3.1",
		"express-jwt-authz": "^2.3.1",
		"helmet": "^3.21.3",
		"jsonwebtoken": "^8.5.1",
		"jwks-rsa": "^1.7.0",
		"knex": "^0.21.21",
		"knex-cleaner": "^1.3.0",
		"moment": "^2.24.0",
		"multer": "^1.4.2",
		"multer-s3": "^2.9.0",
		"pg": "^8.11.3",
		"treeize": "^2.1.2"
	},
	"devDependencies": {
		"cross-env": "^7.0.0",
		"jest": "^25.1.0",
		"jest-aws-simple-mock": "0.0.29",
		"nodemon": "^2.0.2",
		"supertest": "^4.0.2"
	},
	"jest": {
		"testEnvironment": "node",
		"globalSetup": "./tests/setup.js",
		"globalTeardown": "./tests/teardown.js",
		"collectCoverageFrom": [
			"**/*.{js,jsx}",
			"!**/node_modules/**",
			"!**/vendor/**",
			"!**/tests/**",
			"!**/data/**"
		]
	}
}
