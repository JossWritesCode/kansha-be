# Copy to .env and fill in. On Railway, set these as service variables instead.

# --- Database ---
# Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
# Locally: postgres://<user>@localhost:5432/kansha_dev
DATABASE_URL=
# development | production | testing
DB_ENV=development
# Set to true only if your DATABASE_URL requires SSL (e.g. Railway's public proxy URL)
DB_SSL=false

# --- Auth0 (from your Auth0 SPA application) ---
# CLIENT_ID is the Application's Client ID (the id_token audience)
CLIENT_ID=
# Note the trailing slash
DOMAIN=https://YOUR_TENANT.us.auth0.com/
SIGNING_CERT_URL=https://YOUR_TENANT.us.auth0.com/.well-known/jwks.json

# --- URLs ---
# Comma-separated list of allowed browser origins (CORS)
FRONTEND_URL=http://localhost:3000
# Public URL of this API (used to build image links)
PUBLIC_API_URL=http://localhost:8000
# Where static images (badges, default avatar) are hosted. Defaults to first FRONTEND_URL.
# ASSET_BASE_URL=

# --- Image storage (Railway Bucket / any S3-compatible) ---
# Railway: reference the bucket, e.g. BUCKET=${{Bucket.BUCKET}}
BUCKET=
ENDPOINT=https://t3.storageapi.dev
REGION=auto
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
# true only if the bucket's Credentials tab says to use path-style URLs
S3_FORCE_PATH_STYLE=false

# --- Tests (npm test) ---
TEST_DB_HOST=localhost
TEST_DB_USER=postgres
TEST_DB_PASS=
TEST_DB_PORT=5432
